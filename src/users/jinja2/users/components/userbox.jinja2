{% set markers_qty = markers|length %}
{% set objects_qty = objects|length %}
{% set exhibits_qty = ar_exhibits|length + mr_exhibits|length %}
{% set artworks_qty = artworks|length %}
<section class="userbox">
    <div class="countMrk">
        {% if markers_qty %}
            {{ markers_qty }} {{ _(" marker(s)") }}
        {% else %}
            {{ _("No uploads yet.") }}
        {% endif %}
    </div>
    <div class="countObj">
        {% if objects_qty %}
            {{ objects_qty }} {{ _(" Object(s)") }}
        {% else %}
            {{ _("No uploads yet.") }}
        {% endif %}
    </div>
    {% if artworks_qty %}
        <div class="bdgArt">
            <b>
                {{ _("Jandig Artist") }}
            </b>
            <br />
            {{ artworks_qty }} {{ _(" Artworks") }}
        {% else %}
            <div class="bdgArt empty">
                <b>
                    {{ _("No Artworks yet.") }}
                </b>
                <br />
                <a class="" href="{{ url('create-artwork') }}">{{ _("Create your first!") }}</a>
            {% endif %}
        </div>
        {% if exhibits_qty %}
            <div class="bdgCur">
                <b>
                    {{ _("Jandig Curator") }}
                </b>
                <br />
                {{ exhibits_qty }} {{ _(" Exhibits") }}
            {% else %}
                <div class="bdgCur empty">
                    <b>
                        {{ _("No Exhibitions yet.") }}
                    </b>
                    <br />
                    <a class="" href="{{ url('create-ar-exhibit') }}">{{ _("Create your first!") }}</a>
                {% endif %}
            </div>
        </section>
