<!DOCTYPE html>
<html>
    <head>
        <!-- Global site tag (gtag.js) - Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=UA-37240876-2"></script>
        <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'UA-37240876-2');
        </script>
        <link id="manifest" rel="manifest" href="/manifest.json">
        {# <script src="{{ static('js/main.js') }}"></script> #}
        <script type="importmap">
        {
            "imports": {
                "three": "{{ static('libs/three-0.184.0.js') }}",
                "three/addons/GLTFLoader.js": "{{ static('libs/GLTFLoader-0.184.0.js') }}",
                "three/addons/OrbitControls.js": "{{ static('libs/OrbitControls-0.184.0.js') }}"
            }
        }
        </script>
        <script src="https://unpkg.com/htmx.org@2.0.4"
                integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+"
                crossorigin="anonymous"></script>
        <link rel="stylesheet" href="{{ static('css/reset.css') }}">
        <link rel="stylesheet" href="{{ static('css/home.css') }}">
        <link rel="stylesheet" href="{{ static ('css/header.css') }}">
        <title>Jandig</title>
        <meta name="Description" content="Augmented reality artworks!">
        <meta name="viewport"
              content="width=device-width, initial-scale=1, viewport-fit=cover">
        <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..700;1,14..32,300..700&display=swap"
              rel="stylesheet">
        <link rel="shortcut icon"
              href="{{ static('images/icons/favicon.ico') }}"
              type="image/x-icon" />
        <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
        {% block extra_css %}{% endblock %}
    </head>
    <body>
        {% include "core/header.jinja2" %}
        {% block content %}
            <div class="home-container stripped-bg">
                <section class="home-section home-highlight">
                    <div>
                        <h2 id="main_title">{{ _("Welcome to Jandig") }}</h2>
                        <blockquote>
                            {{ _("An open source Extended Reality art community that makes it possible to produce exhibitions and artworks bringing art and technology together.") }}
                        </blockquote>
                    </div>
                </section>
                <section class="home-section">
                    <p>{{ _("In the video below, we introduce Jandig, the idea behind the platform and its possibilities.") }}</p>
                    <div class="video-container">
                        <iframe width="560"
                                height="315"
                                referrerpolicy='strict-origin-when-cross-origin'
                                src="https://www.youtube.com/embed/Oou7uE2XeRo"
                                frameborder="0"
                                allow="autoplay; gyroscope; picture-in-picture"
                                allowfullscreen></iframe>
                    </div>
                </section>
                <section class="home-section">
                    <p>
                        {{ _("If Jandig speaks to you and you think the platform can help you create your augmented reality project (an exhibition, a poster, a sticker, a mural, a book or whatever else your imagination comes up with), here is a step-by-step guide on how to use it. It explains how to upload your content or remix content already on the platform.") }}
                    </p>
                    <div class="video-container" style="margin-bottom:50px">
                        <iframe width="560"
                                height="315"
                                referrerpolicy='strict-origin-when-cross-origin'
                                src="https://www.youtube.com/embed/rMpzwP967V4"
                                frameborder="0"
                                allow="autoplay; gyroscope; picture-in-picture"
                                allowfullscreen>
                        </iframe>
                    </div>
                    {% set signup_url = url("signup") %}
                    <p>
                        {{ _('To follow the guide and put it into practice, <a href="%(signup_url)s">sign up</a> before you start watching. Then come back here and play the video.', signup_url=signup_url) }}
                        {{ _('If you prefer, you can also follow the <a href="%(text_guide_url)s">written step-by-step guide</a>.', text_guide_url="https://jandig.app/docs/publicando-obras.html") }}
                        {{ _('The <a href="%(help_url)s">Help</a> section of the Jandig website also has other tutorials that may be useful. Check them out whenever you need to.', help_url="https://jandig.app/docs/index.html") }}
                    </p>
                    <p>
                        {{ _('We hope to see your artworks and exhibitions on Jandig! If you create something, be sure to share it with us. We have a community <a href="%(telegram_url)s">Telegram channel</a> where you can ask questions and share your creations and experiences.', telegram_url="https://t.me/joinchat/HES_ShA6TMPP-aiHxH7thQ") }}
                    </p>
                </section>
            </div>
        {% endblock %}
        {% include "core/footer.jinja2" %}
    </body>
</html>
