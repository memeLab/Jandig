{% extends '/core/focused_layout.jinja2' %}
{% block extra_css %}
    <link rel="stylesheet" href="{{ static ('css/signup.css') }}">
    <link rel="stylesheet" href="{{ static ('css/exhibit-detail.css') }}">
{% endblock %}
{% block content %}
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <div class="signup-modal container flex">
        <div class="logo">
            <a href="{{ url('home') }}">
                <img src="{{ static ('images/icons/header_icon.png') }}">
            </a>
        </div>
        <div class="exhibit-form">
            <h2>{{ _("Choose the Exhibition you're seeing") }}</h2>
            <form class="search-area"
                  action="{{ url('exhibit_select') }}"
                  method="get">
                <label for="search-box">{{ _("Filter by name") }}</label>
                <input type="text"
                       id="search-box"
                       name="search"
                       value="{{ search }}"
                       autocomplete="off" />
                <input class="submit-btn" type="submit" value="{{ _('Filter') }}" />
            </form>
            {% if no_matches %}
                <p class="exhibit-no-matches">
                    {{ _("No exhibition matches that name.") }}
                    <a href="{{ url('exhibit_select') }}">{{ _("Show all") }}</a>
                </p>
            {% endif %}
            <form name="exhibit-form"
                  action="{{ url('exhibit_select') }}"
                  method="post">
                {{ csrf_input }}
                {% for field in form.visible_fields() %}
                    <p class="exhibit-field {{ field.name }}">
                        {{ field }}
                        {{ field.errors }}
                    </p>
                {% endfor %}
                <input class="submit-btn" type="submit" value="{{ _('Submit') }}" />
            </form>
        </div>
    </div>
    <script>
        let field = document.getElementById('id_exhibit');
        field.style="padding: 0";

        $('#id_exhibit').on('change',function(e){
            if($(this).prop('value') != ''){
                $('input[type="submit"]').prop('disabled', false);
            }else{
                $('input[type="submit"]').prop('disabled', true);
            }
        });
        $('#id_exhibit').on('load',function(e){
            if($(this).prop('value') != ''){
                $('input[type="submit"]').prop('disabled', false);
            }else{
                $('input[type="submit"]').prop('disabled', true);
            }
        });
    </script>
{% endblock %}
